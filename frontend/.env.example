# Firebase Configuration (Updated with your backend's actual Firebase)
# Copy this file to .env and update with your actual Firebase credentials

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=maeve-ai-core-default-rtdb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=maeve-ai-core
VITE_FIREBASE_STORAGE_BUCKET=maeve-ai-core.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_DATABASE_URL=https://maeve-ai-core-default-rtdb.firebaseio.com

# Python TTS Server Configuration
VITE_TTS_SERVER_URL=http://localhost:5000
VITE_TTS_GENERATE_ENDPOINT=/generate
VITE_TTS_VOICE_ENDPOINT=/voice

# Java Backend Configuration (Updated)
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080
VITE_SHELL_EXEC_ENDPOINT=/api/commands
VITE_USER_ID=test_user_001

# Development Settings
VITE_DEV_MODE=true
VITE_DEBUG_MODE=true
