
# Realistic Female Voice API Keys
# Get these from the respective services

# OpenAI TTS (Most realistic, requires API key)
# Sign up: https://platform.openai.com/
# Pricing: $15 per 1M characters (very affordable)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs (Ultra-realistic seductive voices)
# Sign up: https://elevenlabs.io/
# Free tier: 10,000 characters per month
# Paid: $1-5 per 10,000 characters
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Alternative: Coqui TTS (Open source, free)
